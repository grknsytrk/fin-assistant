# Opsiyonel runtime ayarlari
# Bu dosya dogrudan zorunlu degildir, lokal calisma icin referans amaclidir.
# Kullanmak icin kopyalayin: `.env.example` -> `.env`

# Ornek: alternatif config yolu
RAGFIN_CONFIG=config.yaml

# Istege bagli KAP overview yorumu (yapilandirilmis finansal verilerle)
NVIDIA_API_KEY=
NVIDIA_AI_MODEL=minimaxai/minimax-m2.7
NVIDIA_AI_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_AI_TIMEOUT_S=300
NVIDIA_AI_MAX_TOKENS=32000
NVIDIA_AI_MAX_RETRIES=1
NVIDIA_AI_DEBUG=true
VITE_KAP_OVERVIEW_COMMENTARY_TIMEOUT_MS=300000

# KAP finansal ozet: dosya onbellegi TTL (saat). 0 = her zaman canli www.kap.org.tr
# (basarili yanit yine data/processed/kap_cache altina yazilir). Eski davranis icin or. 24.
# RAGFIN_KAP_CACHE_TTL_HOURS=0

# Fon verisi: TEFAS icin tefasfon adapter kullanilir; Fintables sadece fallback'tir.
# Gecerli tipler: SEC,PEN,ETF,RE,VC
RAGFIN_TEFAS_FUND_TYPES=SEC
# 1: yalniz TEFAS alim-satima acik fonlari snapshot/collector hedefine alir.
RAGFIN_TEFAS_OPEN_ONLY=1
# Fon listesi AUM filtresi istege baglidir; varsayilan 0 tum acik fonlari gosterir.
# RAGFIN_FUNDS_LIST_MIN_AUM=300000000
# Fon performans grafigi icin tarih verilmediginde bu tarihten bugune kadar veri cekilir.
RAGFIN_FUNDS_FULL_HISTORY_START_DATE=2000-01-01
# Snapshot probe penceresi takvim günü olarak sınırlıdır; TEFAS verisi yoksa
# resolved_previous_date/not_published ayrımı bu pencereyle yapılır.
RAGFIN_FUNDS_MAX_LOOKBACK_CALENDAR_DAYS=14

# KAP VYK (Veri Yayin Kanali) — resmi REST entegrasyonu
# Auth mode:
# - auto  : prod'da generateToken -> Bearer dener, dev/test'te Basic'e duser
# - basic : her zaman Basic auth kullanir
# - token : her zaman generateToken -> Bearer kullanir
# Test ortami: https://apigwdev.mkk.com.tr/api/vyk
# Canli ortam: https://apigw.mkk.com.tr/api/vyk
RAGFIN_KAP_API_KEY=
RAGFIN_KAP_API_SECRET=
RAGFIN_KAP_VYK_BASE_URL=https://apigwdev.mkk.com.tr/api/vyk
RAGFIN_KAP_VYK_AUTH_MODE=auto
# Bos birakilirsa varsayilan olarak <VYK_BASE_URL>/generateToken kullanilir.
RAGFIN_KAP_VYK_TOKEN_URL=


# Cache backend ayarlari (opsiyonel)
# RAGFIN_CACHE_BACKEND=memory  -> sureç içi TTL cache (varsayilan)
# RAGFIN_CACHE_BACKEND=redis   -> Redis ile paylasimli cache + distributed lock
# Prod/coklu worker icin onerilen: RAGFIN_CACHE_BACKEND=redis
# Redis modu icin asagidaki URL'yi de doldurun:
RAGFIN_CACHE_BACKEND=memory
RAGFIN_REDIS_URL=redis://localhost:6379/0
RAGFIN_CACHE_NAMESPACE=ragfin
# Private TEFAS refresh endpoints. Keep the same value in the HF secret and
# the GitHub Actions secret FIN_API_ADMIN_TOKEN; never expose it to Vite.
RAGFIN_ADMIN_REFRESH_TOKEN=
# Public API korumaları. Çoklu worker prod ortamında edge rate-limit de
# uygulanmalıdır; bu değerler uygulama içi ikinci savunma katmanıdır.
RAGFIN_RATE_LIMIT_PUBLIC_PER_MINUTE=600
RAGFIN_RATE_LIMIT_REVALIDATE_PER_MINUTE=24
RAGFIN_RATE_LIMIT_ALLOCATION_HISTORY_PER_MINUTE=12
# Yalnız güvenilen reverse proxy arkasında true yapın.
RAGFIN_TRUST_PROXY_HEADERS=0
# Fon dağılım geçmişi soğuk cache işi (HTTP isteği içinde TEFAS fan-out yoktur).
RAGFIN_FUND_ALLOCATION_HISTORY_WORKERS=1
RAGFIN_FUND_ALLOCATION_HISTORY_JOB_TTL_SECONDS=1800
RAGFIN_FUND_ALLOCATION_HISTORY_LEASE_TTL_SECONDS=120
RAGFIN_FUNDS_ALLOCATION_HISTORY_DAILY_FALLBACK_MAX_REQUESTS=30
RAGFIN_FUNDS_ALLOCATION_HISTORY_DAILY_MAX_WORKERS=2
# Live holdings enrichment shared cache/single-flight ayarları.
RAGFIN_FUND_HOLDINGS_LIVE_RESPONSE_CACHE_TTL_SECONDS=10
RAGFIN_FUND_HOLDINGS_LIVE_RESPONSE_LOCK_TTL_SECONDS=30
RAGFIN_FUND_HOLDINGS_LIVE_RESPONSE_WAIT_TIMEOUT_SECONDS=2
# TEFAS Retry-After üst sınırı; sağlayıcının değeri exponential backoff'tan
# önceliklidir.
RAGFIN_TEFAS_HTTP_RETRY_AFTER_MAX_SECONDS=300
# Market metadata and quote cache policy.
RAGFIN_MARKET_UNIVERSE_CACHE_TTL_SECONDS=21600
RAGFIN_MARKET_QUOTES_FRESH_TTL_SECONDS=5
RAGFIN_MARKET_QUOTES_STALE_TTL_SECONDS=120
## Paylaşımlı stale-while-revalidate cache: endeks, döviz, emtia, grafik ve KAP yanıtları.
RAGFIN_MARKET_SWR_STALE_TTL_SECONDS=120
RAGFIN_MARKET_SWR_LOCK_TTL_SECONDS=60
RAGFIN_MARKET_SWR_WAIT_TIMEOUT_SECONDS=3
RAGFIN_MARKET_SWR_REVALIDATION_LEASE_TTL_SECONDS=90
RAGFIN_MARKET_SWR_REVALIDATION_WORKERS=2
RAGFIN_KAP_SNAPSHOT_RESPONSE_STALE_TTL_SECONDS=1800
RAGFIN_MARKET_QUOTES_LOCK_TTL_SECONDS=60
RAGFIN_MARKET_QUOTES_WAIT_TIMEOUT_SECONDS=8
RAGFIN_MARKET_QUOTES_POLL_INTERVAL_SECONDS=0.05

# Supabase/PostgreSQL kalici depolama (opsiyonel; HF production icin kullanilir)
# Session pooler URI'sini buraya koyun. Gercek sifreyi kaynak koda yazmayin.
# RAGFIN_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# Refresh generation lease ayarları (Postgres fencing + Redis advisory heartbeat)
RAGFIN_FUND_REFRESH_LEASE_TTL_SECONDS=90
RAGFIN_FUND_REFRESH_HEARTBEAT_INTERVAL_SECONDS=20
RAGFIN_FUND_REFRESH_MAX_RUNTIME_SECONDS=900
